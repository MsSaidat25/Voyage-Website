// ── PHOTO COMPRESSION ────────────────────────────────────────────
function compressImage(file, maxW, maxH, q) {
  return new Promise(function(res) {
    var r = new FileReader();
    r.onload = function(e) {
      var img = new Image();
      img.onload = function() {
        var w=img.width, h=img.height;
        if(w>maxW||h>maxH){ var ratio=Math.min(maxW/w,maxH/h); w=Math.round(w*ratio); h=Math.round(h*ratio); }
        var c=document.createElement('canvas'); c.width=w; c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        res(c.toDataURL('image/jpeg',q||0.8));
      };
      img.src = e.target.result;
    };
    r.readAsDataURL(file);
  });
}

function triggerPhoto(inputId) { document.getElementById(inputId)?.click(); }

function uploadSingle(inp, compId, key) {
  var f = inp.files[0]; if (!f) return;
  compressImage(f, 1920, 900, 0.82).then(function(result) {
    update(compId, key, result);
    rerenderEditor(compId);
  });
}

function uploadMulti(inp, compId, key) {
  var comp = getComp(compId); if (!comp) return;
  if (!comp.data[key]) comp.data[key] = [];
  var files = Array.from(inp.files);
  var idx = 0;
  function next() {
    if (idx >= files.length) {
      markDirty();
      document.getElementById('strip_'+compId).innerHTML = renderPhotoStrip(compId, comp.data[key], key);
      return;
    }
    compressImage(files[idx++], 1200, 900, 0.75).then(function(r) { comp.data[key].push(r); next(); });
  }
  next();
}

// ── SAVE / PUBLISH ───────────────────────────────────────────────
var dirty = false;
function markDirty() { dirty = true; document.getElementById('saveBtn').textContent = 'Save *'; }

function savePage() {
  if (!P) { toast('Create a page first'); return; }
  document.getElementById('saveBtn').textContent = 'Saving...';
  fetch('/api/trips/builder', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(P)
  }).then(r => r.json()).then(d => {
    if (d.success) {
      dirty = false;
      P.id = d.slug;
      document.getElementById('saveBtn').textContent = 'Saved ✓';
      setTimeout(() => { document.getElementById('saveBtn').textContent = 'Save'; }, 2000);
      loadPages();
    } else {
      document.getElementById('saveBtn').textContent = 'Save';
      toast('Error: ' + (d.error || 'Save failed'));
    }
  }).catch(() => { document.getElementById('saveBtn').textContent = 'Save'; toast('Save failed'); });
}

function previewPage() {
  if (!P || !P.id) { toast('Save first to preview'); return; }
  window.open('/trips/v2/' + P.id, '_blank');
}

function publishPage() {
  savePage();
  setTimeout(() => {
    if (P && P.id) {
      toast('✅ Published! Opening...');
      setTimeout(() => window.open('/trips/v2/' + P.id, '_blank'), 800);
    }
  }, 1500);
}

// ── NEW PAGE / META MODAL ─────────────────────────────────────────
function newPage() {
  document.getElementById('mGuestName').value = '';
  document.getElementById('mOccasion').value = '';
  document.getElementById('mDestination').value = '';
  document.getElementById('mDepartDate').value = '';
  document.getElementById('metaModalTitle').textContent = 'New Page';
  document.getElementById('metaModal').classList.add('open');
}

function closeModal() { document.getElementById('metaModal').classList.remove('open'); }

function confirmMeta() {
  var guestName = document.getElementById('mGuestName').value.trim();
  var occasion = document.getElementById('mOccasion').value.trim();
  if (!guestName || !occasion) { toast('Guest name and occasion are required'); return; }
  P = {
    guestName,
    occasion,
    destination: document.getElementById('mDestination').value.trim(),
    departDate: document.getElementById('mDepartDate').value,
    theme: document.getElementById('mTheme').value,
    components: []
  };
  closeModal();
  renderCanvas();
  showLibrary();
  document.getElementById('tripNameDisplay').textContent = guestName + "'s " + occasion;
  document.getElementById('canvasTripName').textContent = guestName + "'s " + occasion;
  markDirty();
  toast('Page created — add blocks from the library →');
}

// ── UTILS ─────────────────────────────────────────────────────────
function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function toast(msg) { var el=document.getElementById('toast'); el.textContent=msg; el.classList.add('show'); setTimeout(()=>el.classList.remove('show'),3000); }
</script>
</body>
</html>
