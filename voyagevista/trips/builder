// ── DATA UPDATES ─────────────────────────────────────────────────
function getComp(id) { return P && P.components.find(c => c.id === id); }

function update(id, key, val) {
  var comp = getComp(id); if (!comp) return;
  comp.data[key] = val;
  markDirty();
  // update canvas preview text
  var block = document.querySelector(`.comp-block[onclick*="${id}"]`);
  if (block) { var nm = block.querySelector('.comp-name'); if(nm) nm.textContent = getCompPreview(comp); }
}

function rerenderEditor(id) {
  var comp = getComp(id); if (!comp) return;
  document.getElementById('rpBody').innerHTML = renderEditor(comp);
}

function updateBtn(id, idx, key, val) {
  var comp = getComp(id); if (!comp) return;
  if (!comp.data.buttons) comp.data.buttons = [];
  if (!comp.data.buttons[idx]) comp.data.buttons[idx] = {};
  comp.data.buttons[idx][key] = val;
  markDirty();
}
function addBtn(id) {
  var comp = getComp(id); if (!comp) return;
  if (!comp.data.buttons) comp.data.buttons = [];
  comp.data.buttons.push({ text:'', url:'' });
  markDirty(); rerenderEditor(id);
