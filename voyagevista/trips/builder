}

function addComp(type) {
  if (!P) return;
  var comp = { id: 'c_' + Date.now(), type: type, data: defaultData(type) };
  P.components.push(comp);
  markDirty();
  renderCanvas();
  selectComp(comp.id);
  // scroll canvas to bottom
  var cb = document.getElementById('canvasBody');
  cb.scrollTop = cb.scrollHeight;
}

